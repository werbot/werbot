import { expect, test } from '@playwright/test';
import en from '../messages/en.json' with { type: 'json' };
import { OWNER, loginAsOwner } from './support/auth';
import { latestEmailLink } from './support/mail';

const bob = { email: 'bob@example.com', login: 'bob', name: 'Bob', password: 'another long password' };

test.describe.serial('identity', () => {
	test('setup, logout, login', async ({ page }) => {
		await page.goto('/');
		await expect(page).toHaveURL(/\/setup$/);
		await page.getByLabel(en.field_email).fill(OWNER.email);
		await page.getByLabel(en.field_login).fill(OWNER.login);
		await page.getByLabel(en.field_name).fill(OWNER.name);
		await page.getByLabel(en.field_password).fill(OWNER.password);
		await page.getByLabel(en.field_org_name).fill(OWNER.org);
		await page.getByRole('button', { name: en.auth_setup_submit }).click();
		await expect(page).toHaveURL('/');
		await expect(page.getByText(en.nav_members)).toBeVisible();

		await page.getByText(en.auth_logout).click();
		await expect(page).toHaveURL(/\/login$/);
		await loginAsOwner(page);
	});

	test('invite and accept', async ({ page, browser }) => {
		await loginAsOwner(page);
		await page.goto('/members');
		await page.getByRole('button', { name: en.members_invite, exact: true }).click();
		await page.getByLabel(en.field_email).fill(bob.email);
		await page.getByRole('button', { name: en.members_invite_submit }).click();
		await expect(page.getByText(en.members_invites_title)).toBeVisible();

		const link = await latestEmailLink(bob.email, 'invite');
		const ctx = await browser.newContext();
		const bobPage = await ctx.newPage();
		await bobPage.goto(link);
		await bobPage.getByLabel(en.field_login).fill(bob.login);
		await bobPage.getByLabel(en.field_name).fill(bob.name);
		await bobPage.getByLabel(en.field_password, { exact: true }).fill(bob.password);
		await bobPage.getByRole('button', { name: en.invite_accept_submit }).click();
		await expect(bobPage).toHaveURL('/');
		await expect(bobPage.getByText(en.nav_members)).toBeHidden();
		await ctx.close();
	});

	test('create team and logout', async ({ page }) => {
		await loginAsOwner(page);
		await page.goto('/teams');
		await page.getByLabel(en.teams_name).fill('ops');
		await page.getByRole('button', { name: en.teams_create_submit }).click();
		await expect(page.getByText('ops', { exact: true })).toBeVisible();

		await page.getByRole('button', { name: en.teams_add_member }).click();
		await page.getByRole('menuitem', { name: bob.name }).click();
		await expect(page.getByText(bob.name, { exact: true })).toBeVisible();

		await page.getByText(en.auth_logout).click();
		await expect(page).toHaveURL(/\/login$/);
		await page.goto('/teams');
		await expect(page).toHaveURL(/\/login$/);
	});
});
