# Werbot image tag to run (required), e.g. v0.1.1. Pin it: see docs/upgrading.md.
WERBOT_VERSION=
# Encrypts stored credentials (required). Generate: openssl rand -base64 32
# Back it up: without it stored credentials cannot be decrypted.
WERBOT_SECRET_KEY=
# PostgreSQL password (required, URL-safe). Generate: openssl rand -hex 24
POSTGRES_PASSWORD=
# Public URL of the web UI; use https:// in production.
WERBOT_PUBLIC_URL=http://localhost:8080
# More settings (SMTP, trusted proxies, S3 for recordings): docs/configuration.md
