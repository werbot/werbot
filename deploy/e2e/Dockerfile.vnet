# Linux client host of the network e2e (deploy/e2e, service vnet): werbot
# connect over wss:// and --vnet, with the tools the checks use.
FROM debian:trixie-20261104-slim@sha256:a72b4433de1cf7d6bae0c4cee74d0547f58601a643b3375f070c51600d63b6b2
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates curl dnsutils iproute2 netcat-openbsd libcap2-bin passwd \
  && rm -rf /var/lib/apt/lists/* \
  && useradd -m werbot
