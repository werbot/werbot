#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_PATH="$(git rev-parse --show-toplevel)"

SUBMODULE_NAMES=()
SUBMODULE_PATHS=()
SUBMODULE_URLS=()

die() {
  echo "[ERROR] $*" >&2
  exit 1
}

usage() {
  cat >&2 <<EOF
Usage: scripts/submodules <command> [options]

Commands:
  status                              Show pin and remote main state
  check --mode main [--rev REF]       Require pin == remote main tip
  check --mode branch [--branch N] [--base REF] [--rev REF]
                                      Require pin == same-named branch tip
  check --pre-push                    Hook mode: validate pushed refs
  sync [--branch N | --pin] [--commit]
                                      Merge module branches or pinned commits into main
  install-hook                        Set core.hooksPath=.githooks
EOF
}

load_submodule_entries() {
  SUBMODULE_NAMES=()
  SUBMODULE_PATHS=()
  SUBMODULE_URLS=()
  local gitmodules="${ROOT_PATH}/.gitmodules"
  [ -f "$gitmodules" ] || return 0
  while read -r key path; do
    local name="${key#submodule.}"
    name="${name%.path}"
    local url
    url=$(git config -f "$gitmodules" "submodule.${name}.url") ||
      die "${path}: missing URL in .gitmodules"
    if submodule_initialized "$path"; then
      url=$(git -C "${ROOT_PATH}/${path}" remote get-url origin 2>/dev/null || echo "$url")
    fi
    SUBMODULE_NAMES+=("$name")
    SUBMODULE_PATHS+=("$path")
    SUBMODULE_URLS+=("$url")
  done < <(git config -f "$gitmodules" --get-regexp '^submodule\..*\.path$')
}

pin_sha() {
  local path="$1" rev="${2:-HEAD}"
  git rev-parse --verify --quiet "${rev}:${path}"
}

submodule_initialized() {
  local abs="${ROOT_PATH}/$1"
  [ -e "${abs}/.git" ] && git -C "$abs" rev-parse --git-dir >/dev/null 2>&1
}

remote_sha() {
  local url="$1" ref="$2" out
  if ! out=$(GIT_TERMINAL_PROMPT=0 git ls-remote "$url" "$ref" 2>/dev/null); then
    return 2
  fi
  awk 'NR==1 {print $1}' <<<"$out"
}

short() {
  printf '%.7s' "$1"
}

cmd_status() {
  load_submodule_entries
  printf '%-14s %-9s %-9s %s\n' "module" "pin" "main" "state"
  local i path url pin main state
  for i in "${!SUBMODULE_PATHS[@]}"; do
    path="${SUBMODULE_PATHS[$i]}"
    url="${SUBMODULE_URLS[$i]}"
    if ! pin=$(pin_sha "$path"); then
      printf '%-14s %-9s %-9s %s\n' "$path" "-" "-" "missing"
      continue
    fi
    if ! main=$(remote_sha "$url" refs/heads/main); then
      state="missing"
      main="unreachable"
    elif [ -z "$main" ]; then
      state="missing"
      main="-"
    elif [ "$pin" = "$main" ]; then
      state="synced"
    else
      state="drift"
    fi
    printf '%-14s %-9s %-9s %s\n' "$path" "$(short "$pin")" "$(short "$main")" "$state"
  done
}

cmd_check_main() {
  local rev="${1:-HEAD}"
  load_submodule_entries
  local i path url pin main errors=0
  for i in "${!SUBMODULE_PATHS[@]}"; do
    path="${SUBMODULE_PATHS[$i]}"
    url="${SUBMODULE_URLS[$i]}"
    if ! pin=$(pin_sha "$path" "$rev"); then
      echo "[ERROR] ${path}: no gitlink in ${rev}" >&2
      errors=$((errors + 1))
      continue
    fi
    if ! main=$(remote_sha "$url" refs/heads/main); then
      echo "[ERROR] ${path}: cannot read remote '${url}'" >&2
      errors=$((errors + 1))
      continue
    fi
    if [ -z "$main" ]; then
      echo "[ERROR] ${path}: remote has no main branch" >&2
      errors=$((errors + 1))
      continue
    fi
    if [ "$pin" != "$main" ]; then
      echo "[ERROR] ${path}: pin $(short "$pin") is not the remote main tip $(short "$main")" >&2
      errors=$((errors + 1))
    fi
  done

  if [ "$errors" -ne 0 ]; then
    echo "[ERROR] submodule check failed: ${errors} violation(s)" >&2
    exit 1
  fi
}

cmd_check_branch() {
  local branch="${1:-}" base="${2:-origin/main}" rev="${3:-HEAD}"
  if [ -z "$branch" ]; then
    branch=$(git symbolic-ref --short -q HEAD) || die "cannot determine the current branch; pass --branch"
  fi
  if ! git rev-parse --verify --quiet "${base}^{commit}" >/dev/null; then
    die "base ref '${base}' not found; fetch it or pass --base"
  fi
  load_submodule_entries

  local i path url pin base_pin branch_tip main errors=0
  for i in "${!SUBMODULE_PATHS[@]}"; do
    path="${SUBMODULE_PATHS[$i]}"
    url="${SUBMODULE_URLS[$i]}"
    if ! pin=$(pin_sha "$path" "$rev"); then
      echo "[ERROR] ${path}: no gitlink in ${rev}" >&2
      errors=$((errors + 1))
      continue
    fi
    base_pin=$(git rev-parse --verify --quiet "${base}:${path}" || true)
    [ "$pin" = "$base_pin" ] && continue

    if ! branch_tip=$(remote_sha "$url" "refs/heads/${branch}"); then
      echo "[ERROR] ${path}: cannot read remote '${url}'" >&2
      errors=$((errors + 1))
      continue
    fi
    if ! main=$(remote_sha "$url" refs/heads/main); then
      echo "[ERROR] ${path}: cannot read remote '${url}'" >&2
      errors=$((errors + 1))
      continue
    fi

    # A branch push may pin the module main tip after sync merged the branch.
    if [ -n "$main" ] && [ "$pin" = "$main" ]; then
      continue
    fi
    if [ -n "$branch_tip" ]; then
      if [ "$pin" != "$branch_tip" ]; then
        echo "[ERROR] ${path}: pin $(short "$pin") is not the tip of remote branch '${branch}' ($(short "$branch_tip"))" >&2
        errors=$((errors + 1))
      fi
      continue
    fi

    if [ -z "$main" ]; then
      echo "[ERROR] ${path}: remote has no main branch" >&2
      errors=$((errors + 1))
    else
      echo "[ERROR] ${path}: branch '${branch}' not found on remote and pin $(short "$pin") is not the remote main tip $(short "$main")" >&2
      errors=$((errors + 1))
    fi
  done

  if [ "$errors" -ne 0 ]; then
    echo "[ERROR] submodule check failed: ${errors} violation(s)" >&2
    exit 1
  fi
}

cmd_check() {
  local mode="branch" branch="" base="origin/main" rev=""
  while [ $# -gt 0 ]; do
    case "$1" in
    --mode)
      mode="$2"
      shift 2
      ;;
    --branch)
      branch="$2"
      shift 2
      ;;
    --base)
      base="$2"
      shift 2
      ;;
    --rev)
      rev="$2"
      shift 2
      ;;
    *)
      die "unknown check option: $1"
      ;;
    esac
  done

  case "$mode" in
  main) cmd_check_main "${rev:-HEAD}" ;;
  branch) cmd_check_branch "$branch" "$base" "${rev:-HEAD}" ;;
  *) die "unknown check mode: ${mode}" ;;
  esac
}

cmd_sync() {
  local branch="" do_commit=0 from_pin=0
  while [ $# -gt 0 ]; do
    case "$1" in
    --branch)
      branch="$2"
      shift 2
      ;;
    --pin)
      from_pin=1
      shift
      ;;
    --commit)
      do_commit=1
      shift
      ;;
    *)
      die "unknown sync option: $1"
      ;;
    esac
  done

  if [ "$from_pin" -eq 1 ] && [ -n "$branch" ]; then
    die "--pin and --branch are mutually exclusive"
  fi

  if [ "$from_pin" -eq 0 ]; then
    if [ -z "$branch" ]; then
      branch=$(git symbolic-ref --short -q HEAD) || die "cannot determine the current branch; pass --branch"
    fi
    [ "$branch" != "main" ] || die "sync refuses to run on main; use check --mode main instead"
  fi

  load_submodule_entries
  local i path url abs errors=0
  for i in "${!SUBMODULE_PATHS[@]}"; do
    path="${SUBMODULE_PATHS[$i]}"
    abs="${ROOT_PATH}/${path}"
    if ! submodule_initialized "$path"; then
      echo "[ERROR] ${path}: not initialized; run git submodule update --init ${path}" >&2
      errors=$((errors + 1))
      continue
    fi
    if [ -n "$(git -C "$abs" status --porcelain)" ]; then
      echo "[ERROR] ${path}: uncommitted changes; commit or stash them first" >&2
      errors=$((errors + 1))
    fi
  done

  if [ "$errors" -ne 0 ]; then
    echo "[ERROR] sync preflight failed: ${errors} violation(s)" >&2
    exit 1
  fi

  local local_ref remote_ref local_sha remote_sha_value new_pin
  local -a synced_paths=()
  for i in "${!SUBMODULE_PATHS[@]}"; do
    path="${SUBMODULE_PATHS[$i]}"
    url="${SUBMODULE_URLS[$i]}"
    abs="${ROOT_PATH}/${path}"

    if [ "$from_pin" -eq 1 ]; then
      pin=$(pin_sha "$path" "HEAD") || die "${path}: no gitlink in HEAD"
      if ! git -C "$abs" fetch -q origin; then
        die "${path}: cannot fetch origin"
      fi
      main_tip=$(git -C "$abs" rev-parse refs/remotes/origin/main) ||
        die "${path}: remote has no main branch"
      [ "$pin" = "$main_tip" ] && continue
      git -C "$abs" cat-file -e "${pin}^{commit}" 2>/dev/null ||
        die "${path}: pinned commit ${pin} is not on the remote; push the module branch first"
      if [ -z "$(git -C "$abs" for-each-ref --contains "$pin" --format='%(refname)' refs/remotes/origin)" ]; then
        die "${path}: pinned commit ${pin} is not on the remote; push the module branch first"
      fi
      git -C "$abs" checkout -q main || die "${path}: cannot check out main"
      git -C "$abs" pull -q --ff-only origin main || die "${path}: cannot fast-forward main"
      if ! git -C "$abs" merge-base --is-ancestor "$pin" HEAD; then
        git -C "$abs" merge --no-edit "$pin" ||
          die "${path}: merge conflict for ${pin}; resolve it in ${abs}"
      fi
      git -C "$abs" push -q origin main || die "${path}: cannot push main"
      git -C "$ROOT_PATH" add "$path"
      synced_paths+=("$path")
      new_pin=$(git -C "$ROOT_PATH" rev-parse ":${path}")
      echo "synced ${path} -> $(short "$new_pin")"
      continue
    fi

    local_ref="refs/heads/${branch}"
    remote_ref="refs/remotes/origin/${branch}"

    if ! git -C "$abs" fetch -q origin; then
      die "${path}: cannot fetch origin"
    fi

    if git -C "$abs" show-ref --verify --quiet "$local_ref"; then
      local_sha=$(git -C "$abs" rev-parse "$local_ref")
      if ! git -C "$abs" show-ref --verify --quiet "$remote_ref"; then
        git -C "$abs" push -q -u origin "$branch" || die "${path}: cannot push branch '${branch}'"
      else
        remote_sha_value=$(git -C "$abs" rev-parse "$remote_ref")
        if [ "$local_sha" != "$remote_sha_value" ]; then
          if git -C "$abs" merge-base --is-ancestor "$remote_ref" "$local_ref"; then
            git -C "$abs" push -q -u origin "$branch" || die "${path}: cannot push branch '${branch}'"
          elif ! git -C "$abs" merge-base --is-ancestor "$local_ref" "$remote_ref"; then
            die "${path}: local and remote branches '${branch}' diverged; merge them manually"
          fi
        fi
      fi
    fi

    if ! git -C "$abs" show-ref --verify --quiet "$remote_ref"; then
      echo "skip ${path}: branch '${branch}' not found"
      continue
    fi

    git -C "$abs" checkout -q main || die "${path}: cannot check out main"
    git -C "$abs" pull -q --ff-only origin main || die "${path}: cannot fast-forward main"
    if ! git -C "$abs" merge -q --ff-only "origin/${branch}" 2>/dev/null; then
      git -C "$abs" merge --no-edit "origin/${branch}" ||
        die "${path}: merge conflict on '${branch}'; resolve it in ${abs}"
    fi
    git -C "$abs" push -q origin main || die "${path}: cannot push main"
    git -C "$ROOT_PATH" add "$path"
    synced_paths+=("$path")
    new_pin=$(git -C "$ROOT_PATH" rev-parse ":${path}")
    echo "synced ${path} -> $(short "$new_pin")"
  done

  if [ "$do_commit" -eq 1 ] && [ "${#synced_paths[@]}" -gt 0 ] &&
    ! git -C "$ROOT_PATH" diff --cached --quiet; then
    local modified IFS=,
    modified="${synced_paths[*]}"
    git -C "$ROOT_PATH" commit -q --only \
      -m "🔧 chore(submodules): sync submodule pins with main [skip reconcile]" \
      -m "Changes made in this commit:
- Modified: ${modified}

Key changes:
- Update parent gitlinks to the merged module main tips" \
      -- "${synced_paths[@]}"
    echo "committed submodule pins"
  fi
}

cmd_check_pre_push() {
  if [ "${SKIP_SUBMODULE_CHECK:-0}" = "1" ]; then
    echo "[WARN] submodule check skipped by SKIP_SUBMODULE_CHECK=1" >&2
    return 0
  fi

  local zero="0000000000000000000000000000000000000000"
  local main_sha="" local_ref local_sha remote_ref remote_sha_value
  local -a branch_names=()
  local -a branch_shas=()

  if [ -t 0 ]; then
    local current
    current=$(git symbolic-ref --short -q HEAD) || die "cannot determine the current branch"
    if [ "$current" = "main" ]; then
      main_sha=$(git rev-parse HEAD)
    else
      branch_names=("$current")
      branch_shas=("HEAD")
    fi
  else
    while read -r local_ref local_sha remote_ref remote_sha_value; do
      [ -n "$remote_ref" ] || continue
      if [ "$local_sha" = "$zero" ]; then
        continue
      fi
      case "$remote_ref" in
      refs/heads/main)
        main_sha="$local_sha"
        ;;
      refs/heads/*)
        branch_names+=("${remote_ref#refs/heads/}")
        branch_shas+=("$local_sha")
        ;;
      esac
    done
  fi

  if [ -n "$main_sha" ]; then
    cmd_check_main "$main_sha"
  fi
  local i
  for i in "${!branch_names[@]}"; do
    cmd_check_branch "${branch_names[$i]}" "origin/main" "${branch_shas[$i]}"
  done
  if [ -z "$main_sha" ] && [ "${#branch_names[@]}" -eq 0 ]; then
    cmd_check_branch "" "origin/main" "HEAD"
  fi

  load_submodule_entries
  local path url abs branch upstream ahead errors=0
  for i in "${!SUBMODULE_PATHS[@]}"; do
    path="${SUBMODULE_PATHS[$i]}"
    abs="${ROOT_PATH}/${path}"
    submodule_initialized "$path" || continue

    if [ -n "$(git -C "$abs" status --porcelain)" ]; then
      echo "[WARN] ${path}: uncommitted changes will not be pushed" >&2
    fi

    branch=$(git -C "$abs" symbolic-ref --short -q HEAD) || continue
    if ! upstream=$(git -C "$abs" rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null); then
      echo "[ERROR] ${path}: branch '${branch}' has no upstream; push it" >&2
      errors=$((errors + 1))
      continue
    fi
    ahead=$(git -C "$abs" rev-list --count '@{u}..HEAD')
    if [ "$ahead" -gt 0 ]; then
      echo "[ERROR] ${path}: branch '${branch}' has ${ahead} unpushed commit(s)" >&2
      errors=$((errors + 1))
    fi
  done

  if [ "$errors" -ne 0 ]; then
    echo "[ERROR] submodule pre-push check failed: ${errors} violation(s)" >&2
    exit 1
  fi
}

cmd_install_hook() {
  git -C "$ROOT_PATH" config core.hooksPath .githooks
  echo "git hooks installed at ${ROOT_PATH}/.githooks"
}

case "${1:-}" in
status)
  shift
  cmd_status "$@"
  ;;
check)
  shift
  if [ "${1:-}" = "--pre-push" ]; then
    shift
    cmd_check_pre_push
  else
    cmd_check "$@"
  fi
  ;;
sync)
  shift
  cmd_sync "$@"
  ;;
install-hook)
  shift
  cmd_install_hook "$@"
  ;;
"" | help | -h | --help)
  usage
  ;;
*)
  usage
  exit 2
  ;;
esac
