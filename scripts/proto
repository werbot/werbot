#!/usr/bin/env bash

set -e

ROOT_PATH="$(git rev-parse --show-toplevel)"
source ${ROOT_PATH}/scripts/_helper

# Directory holding third-party .proto files installed by `scripts/tools app`
# (buf/validate/validate.proto from protovalidate).
GROUND_PATH="$HOME/.local/include"

protogen() {
  local PROTO_PATH=""
  local WEB_PATH=""
  if [ -z "$3" ]; then
    PROTO_PATH=${ROOT_PATH}/internal/core/${1}/proto
    #WEB_PATH=${ROOT_PATH}/web/src/proto/${1}
    WEB_PATH=${ROOT_PATH}/web/src/proto
  else
    PROTO_PATH=${ROOT_PATH}/add-on/${3}/internal/core/${1}/proto
    #WEB_PATH=${ROOT_PATH}/add-on/${3}/web/proto/${1}
    WEB_PATH=${ROOT_PATH}/add-on/${3}/web/proto
  fi

  FOLDER_LEN=$(find "$PROTO_PATH" -mindepth 1 -type d | wc -l)
  PROTO_PATH=$PROTO_PATH/${2}

  proto_files=$(find "${PROTO_PATH}" -type f -name "*.proto")
  if [ -z "$proto_files" ]; then
    echo "ERROR"
  else
    if [ "$FOLDER_LEN" -gt 1 ]; then
      WEB_PATH=$WEB_PATH/${1}
      mkdir -p "$WEB_PATH"
    fi

    for file in $proto_files; do
      proto_file=$(basename "$file" .proto)
      # Pass the repository-relative path so generated descriptors register under
      # a unique file path. Using the basename makes every package register
      # "enum.proto" / "message.proto" / "rpc.proto" and any two of them linked
      # into one binary panic with "file already registered".
      proto_rel=${file#"$ROOT_PATH"/}

      protoc --proto_path=$ROOT_PATH \
        --proto_path=$GROUND_PATH \
        --proto_path=$PROTO_PATH \
        --go_out=paths=import,module=github.com/werbot/werbot:$ROOT_PATH \
        --go-grpc_out=paths=import,module=github.com/werbot/werbot:$ROOT_PATH \
        --plugin=protoc-gen-ts=${ROOT_PATH}/web/node_modules/.bin/protoc-gen-ts \
        --ts_out=$WEB_PATH \
        --ts_opt=use_proto_field_name,ts_nocheck,long_type_string,force_optimize_code_size,force_client_none \
        ${proto_rel}

      # Update or add tags
      protoc-go-inject-tag -input="$PROTO_PATH/${proto_file}.pb.go" -remove_tag_comment

      # Keep the generated Go formatted: inject-tag can leave stray whitespace.
      for generated in "$PROTO_PATH/${proto_file}.pb.go" "$PROTO_PATH/${proto_file}_grpc.pb.go"; do
        if [ -f "$generated" ]; then
          gofmt -w "$generated"
        fi
      done

      # Clean up extra version information the proto compiler adds to
      # the files. perl is used instead of sed because the -i/-e forms differ
      # between GNU sed (Linux) and BSD sed (macOS).
      perl -0pi -e 's|// versions:.+?// source:|// source:|s' $PROTO_PATH/*.pb.go

      # protoc-gen-ts mirrors the repository-relative input path under the
      # output directory because the file is compiled from the repository root.
      # Move the result into the flat module folder and rewrite its imports.
      TS_SOURCE="$WEB_PATH/${proto_rel%.proto}.ts"
      if [ -f "$TS_SOURCE" ]; then
        TS_FILE="$WEB_PATH/${proto_file}.ts"
        mv -f "$TS_SOURCE" "$TS_FILE"
        rmdir -p "$(dirname "$TS_SOURCE")" 2>/dev/null || true

        perl -pi -e '
          $_ = "" if m{^// \@generated by protobuf-ts};
          s{from "(?:\.\./)+[^"]*?/google/protobuf/([^"/]+)"}{from "../google/protobuf/$1"}g;
          s{from "(?:\.\./)+[^"]*?/buf/validate/validate"}{from "../buf/validate/validate"}g;
          s{from "(?:\.\./)+([^"/]+)/([^"/]+)"}{from "./$2"}g;
          s{from "(?:\.\./)+.*?/([^"/]+)/proto/([^"/]+)/([^"/]+)"}{from "../$1/$3"}g;
        ' "$TS_FILE"

        # protoc-gen-ts emits imported well-known types next to the module;
        # keep a single shared google/ folder one level up.
        if [ -d "$WEB_PATH/google/" ]; then
          mkdir -p "$WEB_PATH/../google"
          rsync -a "$WEB_PATH/google/" "$WEB_PATH/../google/"
          rm -rf "$WEB_PATH/google"
        fi
      fi
    done
  fi
}

generate_protos() {
  local path="$1"
  local prefix="$2"
  local addon="$3"

  for entry in "${path}"/*/; do
    name=$(basename "${entry}")
    if [[ -z "$addon" ]]; then
      print_header "${COLOR_YELLOW}${prefix}${COLOR_RESET}:${COLOR_BLUE}${name}${COLOR_RESET}"
      OTPUT=$(protogen "$prefix" "$name")
    else
      print_header "{$addon}::${COLOR_YELLOW}${prefix}${COLOR_RESET}:${COLOR_BLUE}${name}${COLOR_RESET}"
      OTPUT=$(protogen "$prefix" "$name" "$addon")
    fi

    if [[ "$OTPUT" == "ERROR" ]]; then
      print_answer "ERROR" red
    else
      print_answer "SUCCESS" green
    fi
  done
}

addons=(ee saas)

# `scripts/proto <module> <addon>` regenerates only the add-on module, which is
# required when the core has a module with the same name (for example license).
if [[ $# -gt 1 ]]; then
  target_path="${ROOT_PATH}/add-on/$2/internal/core/$1/proto"
  if [ -d "$target_path" ]; then
    generate_protos "$target_path" "$1" "$2"
  else
    print_header "Protos $2::$1"
    print_answer "ERROR" red
    echo "module $1 not found in add-on/$2"
    exit 1
  fi
elif [[ $# -gt 0 ]]; then
  target_path="${ROOT_PATH}/internal/core/$1/proto"
  if [ -d "$target_path" ]; then
    generate_protos "$target_path" "$1"
  else
    for addon in "${addons[@]}"; do
      target_path="${ROOT_PATH}/add-on/$addon/internal/core/$1/proto"
      if [ -d "$target_path" ]; then
        generate_protos "$target_path" "$1" "$addon"
      fi
    done
  fi
else
  target_path="${ROOT_PATH}/internal/core"
  for entry in ${target_path}/*/; do
    name=$(basename "${entry}")
    generate_protos "${target_path}/$name/proto" "$name"
  done

  for addon in "${addons[@]}"; do
    target_path="${ROOT_PATH}/add-on/${addon}"
    if [ -d "$target_path" ]; then
      for entry in ${target_path}/internal/core/*/; do
        name=$(basename "${entry}")
        if [[ $name != "*" ]]; then
          generate_protos "${target_path}/internal/core/$name/proto" "$name" $addon
        fi
      done
    fi
  done
fi
